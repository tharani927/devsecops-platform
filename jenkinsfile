pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker') {
            steps {
                sh 'docker --version'
                sh 'docker compose version'
                sh 'docker compose build'
            }
        }

        stage('Run Application') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }
}